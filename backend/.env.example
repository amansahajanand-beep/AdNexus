# Postgres (for USE_PG_USERS=true)
PG_HOST=localhost
PG_PORT=5432
PG_USER=gam_user
PG_PASSWORD=gam_password
PG_DATABASE=gam_dashboard
PG_SSL=false

# Enable using Postgres for dashboard users (run migration at startup)
USE_PG_USERS=true

# Redis — required for BullMQ + small response cache. Postgres is source of truth.
# Flow: cron → PostgreSQL → first API hit may warm Redis (TTL below).
REDIS_URL=redis://localhost:6379
REDIS_DISABLED=false
# Skip caching arrays larger than this (prevents OOM + Upstash command burn).
REDIS_MAX_ARRAY_ITEMS=3000
# Cap SCAN rounds per pattern during cache invalidation.
REDIS_MAX_SCAN_ROUNDS=8
# Cool-off when Upstash returns "max requests limit exceeded" (ms).
REDIS_QUOTA_COOLDOWN_MS=120000

# Warehouse: days of hot grain in report_grain (default 365). Older data → S3 when ARCHIVE_ENABLED=true.
HISTORICAL_DAYS=365

# S3-compatible cold archive (365+ day data)
ARCHIVE_ENABLED=false
S3_ENDPOINT=https://your-s3-endpoint
S3_BUCKET=gam-dashboard-archive
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
# Parallel month GAM jobs on the worker (1–5). sync-today stays priority 1.
GAM_SYNC_CONCURRENCY=2
# PG pool shared by sync + API (raise if Dashboard still times out during sync)
# PG_POOL_MAX=40
# Fail fast when the pool is saturated (default was 60000 — amplified stampedes)
# PG_CONNECT_TIMEOUT_MS=10000
# Delay startup ALTER/rollup so login/dashboard are not fighting locks
# STARTUP_DDL_DELAY_MS=8000
# Cap concurrent grain overview scans
# GRAIN_OVERVIEW_MAX=2
# OVERVIEW_STATEMENT_TIMEOUT_MS=12000
# SYNC_EXTENDED_BOOT_DELAY_MS=1200000
# SYNC_EXTENDED_YDAY_DELAY_MS=900000
# Skip inline GAM→Postgres persist above this row count (overview/dashboard). Sync queue fills warehouse.
GAM_PERSIST_MAX_ROWS=5000
# GAM lean slice used for overview/dashboard KPI totals (avoids multi-slice double-count).
# Overview KPI totals — use channel slice to match GAM programmatic-channel overview
CANONICAL_KPI_SLICE=channel
# Rows normalized + upserted per chunk during report_grain writes (lowers peak heap).
GRAIN_NORMALIZE_CHUNK=500
# Set false on the API when running `npm run worker` in a separate process.
RUN_IN_PROCESS_WORKERS=true
# Reporting custom GAM cap (select-all uses grain SQL instead).
MAX_CUSTOM_REPORT_DIMS=8
MAX_CUSTOM_REPORT_METRICS=10

# Google Ad Manager OAuth (used by Connect with Google — users do not paste these)
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
GOOGLE_REDIRECT_URI=http://localhost:3001/auth/callback
# Optional bootstrap / legacy — Connect with Google discovers network + refresh token
GOOGLE_REFRESH_TOKEN=YOUR_GOOGLE_REFRESH_TOKEN
GAM_NETWORK_CODE=YOUR_GAM_NETWORK_CODE

# Google Ads API (ROI spend sync) — Connect with Google lists MCCs for the signed-in email
GOOGLE_ADS_DEVELOPER_TOKEN=YOUR_GOOGLE_ADS_DEVELOPER_TOKEN
GOOGLE_ADS_CLIENT_ID=YOUR_ADS_OAUTH_CLIENT_ID.apps.googleusercontent.com
GOOGLE_ADS_CLIENT_SECRET=YOUR_ADS_OAUTH_CLIENT_SECRET
GOOGLE_ADS_REDIRECT_URI=http://localhost:3001/auth/ads/callback
# Optional: force Ads account currency (INR|USD|…). ROI spend uses cost_native to match Ads UI.
# ADS_FORCE_CURRENCY=INR
# Sync only Include-in-ROI accounts (default true) — cuts BullMQ/Upstash job chatter.
# ADS_SYNC_ROI_ONLY=true
# Opt-in overlapping Ads crons (off by default to protect Upstash command budget):
# ADS_RECONCILE_CRON=false
# ADS_RECENT_CRON=false
# Optional: days of Ads spend to backfill on connect / daily catch-up
GOOGLE_ADS_SYNC_LOOKBACK_DAYS=30
# Fallback every-3h refresh window (hourly today + :30 reconcile cover most cases).
GOOGLE_ADS_RECENT_SYNC_DAYS=3

# AdMob / AdSense (publisher products) — optional dedicated OAuth; falls back to GOOGLE_CLIENT_*
# Enable AdMob API + AdSense Management API on the Cloud project, add redirect URIs below.
# GOOGLE_ADMOB_CLIENT_ID=
# GOOGLE_ADMOB_CLIENT_SECRET=
GOOGLE_ADMOB_REDIRECT_URI=http://localhost:3001/auth/admob/callback
ADMOB_SYNC_LOOKBACK_DAYS=30
# mediation (default) matches AdMob console totals (includes 3P networks). Use network for AdMob-only.
# ADMOB_REPORT_FLAVOR=mediation
# GOOGLE_ADSENSE_CLIENT_ID=
# GOOGLE_ADSENSE_CLIENT_SECRET=
GOOGLE_ADSENSE_REDIRECT_URI=http://localhost:3001/auth/adsense/callback
ADSENSE_SYNC_LOOKBACK_DAYS=30

# After rotating Google OAuth secrets in production .env, set true for ONE restart
# so gam_clients is updated from env (live API uses DB credentials, not .env).
# Then set back to false.
SYNC_GAM_CREDS_FROM_ENV=false

# JWT secret
JWT_SECRET=change_this_secret

# Encrypts per-client Google client_secret + refresh_token in Postgres.
# Use a long random string (32+ chars). Falls back to JWT_SECRET if unset.
CREDENTIALS_ENCRYPTION_KEY=change_this_credentials_key

# Other settings
PORT=3001
# Set true only to disable cron/BullMQ/Redis sync pipeline entirely.
SYNC_DISABLED=false
# Set true to skip multi-slice Reporting sync (report_full_*), lean tables only.
FULL_SYNC_DISABLED=false
# Daily 2AM backfill includes full warehouse slices (heavy). Prefer weekly (default).
FULL_BACKFILL_DAILY=false
# Redis/API report cache TTL in seconds (default 30 min).
CACHE_TTL=1800
# Cap in-process NodeCache entries (heap protection).
NODE_CACHE_MAX_KEYS=250
# NodeCache is L1 only — skip arrays larger than this (grain dumps belong in Postgres).
NODE_CACHE_MAX_ARRAY=3000
# Stream GAM CSV in this many rows per upsert batch.
GAM_CSV_BATCH=2000
# Max days per GAM sync job (avoids 2M+ row month downloads).
GAM_SYNC_MAX_DAYS=7
# Hourly today-priority: pause/yield historical backfill while sync-today runs.
# TTL for the Redis/in-process flag (seconds). Wait timeout for sync-today success (ms).
# Defer delay when a backfill job is moved aside (ms).
SYNC_TODAY_PRIORITY_TTL_SEC=1500
SYNC_TODAY_PRIORITY_WAIT_MS=1200000
SYNC_TODAY_PRIORITY_DEFER_MS=60000
# HTTP live GAM parse cap (catalog scans can be ~350k). Warehouse sync always streams.
MAX_IN_MEMORY_GAM_ROWS=400000
# Cap lean grain rows loaded into Node from Postgres.
MAX_LEAN_GRAIN_ROWS=25000
# First status-check delay after submitting a GAM report job (ms). Lower = snappier misses.
GAM_REPORT_FIRST_POLL_MS=400
SESSION_EXPIRES_IN=7d

# ─── AI features (off by default) ────────────────────────────────────────────
# Master switch. Also needs ANTHROPIC_API_KEY. Per-account on/off is set in the app (PUT /api/ai/settings).
AI_ENABLED=false
# Accounts with no explicit setting follow this value.
AI_DEFAULT_ENABLED=false
# AI features are for admins only. Set to false to let domain (non-admin) users use them too.
AI_ADMIN_ONLY=true
ANTHROPIC_API_KEY=
# Model tiers: "fast" = instant summary, "deep" = on-demand analysis.
# AI_MODEL_FAST=claude-haiku-4-5
# AI_MODEL_DEEP=claude-sonnet-5-5
# AI_EFFORT_DEEP=medium
# AI_MAX_TOKENS_FAST=1200
# AI_MAX_TOKENS_DEEP=6000
# AI_TIMEOUT_FAST_MS=20000
# AI_TIMEOUT_DEEP_MS=90000
# Limits (per user per minute, tokens per user/account per UTC day)
# AI_RPM_PER_USER=10
# AI_TOKENS_PER_USER_DAY=300000
# AI_TOKENS_PER_CLIENT_DAY=3000000
# Nightly pre-warm of pinned presets (yesterday and last 7 days), so they open already analyzed.
# AI_PREWARM_ENABLED=false
# AI_PREWARM_CRON=30 6 * * *
# AI_PREWARM_MAX=100
# Nightly alert scan across GAM, AdMob and AdSense (alerts also refresh when an admin opens the list).
# AI_ALERTS_ENABLED=false
# AI_ALERTS_CRON=0 7 * * *
# Ask-your-data chat (tool-using turns; timeout is per turn).
# AI_MODEL_CHAT=claude-sonnet-5-5
# AI_EFFORT_CHAT=medium
# AI_MAX_TOKENS_CHAT=8000
# AI_TIMEOUT_CHAT_MS=60000
# Server-side refusal fallback on Sonnet 5.5 / Opus 5.x (Claude API only). Set false to turn off.
# AI_FALLBACKS=true
# Weekly executive report (Mondays 08:00 by default); admins can also generate it on demand.
# AI_REPORT_ENABLED=false
# AI_REPORT_CRON=0 8 * * 1

# ─── AI provider ─────────────────────────────────────────────────────────────
# OpenAI-style chat-completions endpoint (e.g. NVIDIA-hosted Nemotron). When AI_API_URL and AI_API_KEY are
# set this is used automatically; set AI_PROVIDER=anthropic to use ANTHROPIC_API_KEY instead.
# AI_PROVIDER=openai
# AI_API_URL=https://integrate.api.nvidia.com/v1/chat/completions
# AI_API_KEY=
# AI_MODEL=nvidia/nemotron-3-ultra-550b-a55b
# AI_TIMEOUT_MS=120000
# How long the same analysis for the same user, preset and dates is reused without rebuilding it.
# AI_ANALYSIS_TTL_SECONDS=120
# Private "thinking" is off by default: it costs seconds and eats the output budget. Turn on per tier
# (and raise AI_MAX_TOKENS_<TIER>) only if answer quality needs it.
# AI_THINKING_FAST=false
# AI_THINKING_DEEP=false
# AI_THINKING_CHAT=false
# JSON mode makes this kind of endpoint hold back the whole reply, so nothing streams. Leave off.
# AI_JSON_MODE=false
# Optional: log a cost estimate (USD per million tokens).
# AI_PRICE_INPUT_PER_M=
# AI_PRICE_OUTPUT_PER_M=
