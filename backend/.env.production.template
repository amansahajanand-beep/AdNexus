# ============================================================
# Google Ad Manager Credentials
# Copy this file to .env on the server and fill in real values.
# Never commit real client secrets or refresh tokens.
# ============================================================
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
GOOGLE_REDIRECT_URI=https://YOUR_PRODUCTION_DOMAIN/auth/callback

GOOGLE_REFRESH_TOKEN=YOUR_GOOGLE_REFRESH_TOKEN

# ============================================================
# GAM Config
# ============================================================
GAM_NETWORK_CODE=YOUR_GAM_NETWORK_CODE
GAM_CURRENCY=USD
GAM_API_VERSION=v202602

# ============================================================
# App Config
# ============================================================
PORT=3099
NODE_ENV=production
FRONTEND_URL=https://YOUR_PRODUCTION_DOMAIN
APP_TIMEZONE=Asia/Singapore
CACHE_TTL=300
JWT_SECRET=change_this_to_a_long_random_string
CREDENTIALS_ENCRYPTION_KEY=change_this_credentials_key

# ============================================================
# PostgreSQL
# ============================================================
PG_HOST=localhost
PG_PORT=5433
PG_USER=gam_user
PG_PASSWORD=change_this_db_password
PG_DATABASE=gam_dashboard
PG_SSL=false

# ============================================================
# Redis
# ============================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ============================================================
# Sync settings
# ============================================================
SYNC_DISABLED=true
USE_PG_USERS=true
